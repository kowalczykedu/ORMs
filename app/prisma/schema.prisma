generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum StatusPedido {
  pendente
  pago
  enviado
  entregue
  cancelado
}

model Categoria {
  id       Int       @id @default(autoincrement())
  nome     String    @unique @db.VarChar(50)
  produtos Produto[]

  @@map("categorias")
}

model Cliente {
  id           Int      @id @default(autoincrement())
  nome         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(100)
  cidade       String   @db.VarChar(50)
  dataCadastro DateTime @map("data_cadastro") @db.Date
  pedidos      Pedido[]

  @@map("clientes")
}

model Produto {
  id          Int          @id @default(autoincrement())
  nome        String       @db.VarChar(100)
  preco       Decimal      @db.Decimal(10, 2)
  estoque     Int          @default(0)
  categoriaId Int          @map("categoria_id")

  categoria   Categoria    @relation(fields: [categoriaId], references: [id], onUpdate: Cascade, onDelete: Restrict, map: "fk_produtos_categoria")
  itens       ItemPedido[]

  @@map("produtos")
}

model Pedido {
  id         Int          @id @default(autoincrement())
  clienteId  Int          @map("cliente_id")
  dataPedido DateTime     @map("data_pedido") @db.Date
  status     StatusPedido @default(pendente)

  cliente    Cliente      @relation(fields: [clienteId], references: [id], onUpdate: Cascade, onDelete: Restrict, map: "fk_pedidos_cliente")
  itens      ItemPedido[]

  @@map("pedidos")
}

model ItemPedido {
  id            Int     @id @default(autoincrement())
  pedidoId      Int     @map("pedido_id")
  produtoId     Int     @map("produto_id")
  quantidade    Int
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(10, 2)

  pedido        Pedido  @relation(fields: [pedidoId], references: [id], onUpdate: Cascade, onDelete: Cascade, map: "fk_itens_pedido")
  produto       Produto @relation(fields: [produtoId], references: [id], onUpdate: Cascade, onDelete: Restrict, map: "fk_itens_produto")

  @@map("itens_pedido")
}
