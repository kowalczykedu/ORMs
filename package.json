{
  "name": "techstore-orms-root",
  "version": "1.0.0",
  "private": true,
  "description": "Atalho raiz para iniciar o ambiente TechStore (Windows sem Docker ou direto via app/)",
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./iniciar-windows.ps1",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./iniciar-windows.ps1 -SetupOnly",
    "stop:db": "powershell -NoProfile -ExecutionPolicy Bypass -File ./parar-windows.ps1",
    "slides": "powershell -NoProfile -Command \"Start-Process './docs/slides-exemplo.html'\""
  }
}
